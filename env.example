# Copy this file to .env for local runs, or set the same variable in
# Render's dashboard under Environment for the deployed service.

# Get this from Supabase: Project -> Connect -> "Session pooler" tab.
# Must be the SESSION POOLER string (port 5432), not "Direct connection" --
# the direct connection is IPv6-only and Render's network is IPv4.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
